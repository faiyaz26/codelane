# Root pnpm configuration for Codelane
# This ensures Tauri CLI native bindings work correctly on all platforms

# Enable hoisting at root level to fix Tauri CLI native bindings
# See: https://github.com/tauri-apps/tauri/issues/2849
shamefully-hoist=true

# Auto-install peer dependencies
auto-install-peers=true

# Don't be too strict about peer dependencies
strict-peer-dependencies=false
